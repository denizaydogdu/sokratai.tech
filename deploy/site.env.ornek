# /etc/ai-ogretmen/site.env — AI Öğretmen sitesinin ortam değişkenleri (ŞABLON; gerçek değerler GİT'E GİRMEZ)
#   sudo install -d -m 0750 -o root -g ai-ogretmen /etc/ai-ogretmen
#   sudo install -m 0640 -o root -g ai-ogretmen deploy/site.env.ornek /etc/ai-ogretmen/site.env
#   sudo nano /etc/ai-ogretmen/site.env      # <...> yer tutucularını doldur
# systemd EnvironmentFile biçimi: ANAHTAR=değer (tırnak gerekmez; satır sonu yorumu YAZMA).
# Dokploy (Docker + Traefik, ADR-0018) için de geçerli: aynı değişkenler Dokploy → Environment'a girilir;
# SPRING_DATASOURCE_URL'de host = Dokploy Postgres servisinin iç adı (docs/kurulum-site.md §10.3).
#
# Girişsiz site (ADR-0017): hesap/e-posta/SMTP YOK. OpenRouter anahtarı da YOK — sohbeti kullanan ziyaretçi
# kendi anahtarını tarayıcıdan getirir; OPENROUTER_API_KEY buraya YAZILMAZ (yazılsa da sitede kullanılmaz).

# --- Veritabanı (PostgreSQL, ADR-0014) — ZORUNLU; yoksa site açılmaz ---
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/ai_ogretmen
SPRING_DATASOURCE_USERNAME=ai_ogretmen
SPRING_DATASOURCE_PASSWORD=<veritabani-sifresi>
# Bağlantı havuzu (varsayılan 10)
# APP_SITE_DB_HAVUZ=10
# Havuzdan bağlantı bekleme üst sınırı, ms (varsayılan 5000). Sağlık kontrolü zaman aşımı bundan + 2 sn büyük olmalı.
# APP_SITE_DB_BAGLANTI_ZAMAN_ASIMI_MS=5000

# --- Site adresi (nginx önündeki gerçek https adres) ---
# CSRF Origin denetimi: tarayıcının gönderdiği origin birebir (virgülle çoklu)
APP_SITE_IZINLI_ORIGINLER=https://egitim.ornek.com
# Çerezler Secure (canlıda DAİMA true; yalnız yerel http denemesinde false)
APP_SITE_GUVENLI_CEREZ=true
# Güvenilir vekil (Java regex; yoksa Tomcat varsayılanı: 10/8, 172.16/12, 192.168/16, 127/8 …). Docker/Dokploy'da
# Traefik konteynerinin IP'sine/alt ağına daralt — docs/kurulum-site.md §10.5. systemd + nginx yolunda gerekmez.
# APP_SITE_GUVENILIR_VEKIL=<traefik-ip-regex>

# --- SEO ve analitik (isteğe bağlı; ADR-0019, docs/kurulum-site.md §10.7) ---
# Sitenin kök adresi (şema dahil, yol yok): canonical, og:url, robots.txt Sitemap satırı, sitemap.xml. Boş = bunlar yok.
# APP_SITE_TEMEL_URL=https://egitim.ornek.com
# Google Analytics 4 ölçüm kimliği (G-XXXXXXXXXX). Boş = analitik TAMAMEN kapalı (betik yüklenmez, veri gitmez).
# APP_SITE_GA_OLCUM_KIMLIGI=G-XXXXXXXXXX

# --- Hız sınırları (isteğe bağlı; varsayılanlar aşağıda, pencereler sabit) — docs/kurulum-site.md §7.6 ---
# Tek NAT arkasındaki sınıf/ofis (herkes aynı IP) için yeni ziyaretçi ve yazma sınırlarını yükselt.
# APP_SITE_HIZ_YAZMA_DAKIKA=60
# APP_SITE_HIZ_SOHBET_DAKIKA=20
# APP_SITE_HIZ_GERI_YUKLE_SAAT=10
# APP_SITE_HIZ_YENI_ZIYARETCI_SAAT=20
